{
  "name": "@duskdomains/sdk",
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "description": "TypeScript SDK and integration helpers for Dusk Domains.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./writes": {
      "types": "./dist/writes.d.ts",
      "import": "./dist/writes.js"
    },
    "./marketplace": {
      "types": "./dist/marketplace.d.ts",
      "import": "./dist/marketplace.js"
    },
    "./connect-app": {
      "types": "./dist/wallet/duskConnectApp.d.ts",
      "import": "./dist/wallet/duskConnectApp.js"
    },
    "./event-catalog": {
      "types": "./dist/indexer/events/indexerEventCatalog.d.ts",
      "import": "./src/indexer/events/indexerEventCatalog.mjs"
    },
    "./projection": {
      "types": "./dist/projection.d.ts",
      "import": "./dist/projection.js"
    },
    "./chain-addresses": {
      "types": "./dist/chain-addresses.d.ts",
      "import": "./dist/chain-addresses.js"
    },
    "./indexer": {
      "types": "./dist/indexer.d.ts",
      "import": "./dist/indexer.js"
    }
  },
  "files": [
    "dist",
    "src",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-event-catalog.mjs",
    "jsr:dry-run": "npx jsr publish --dry-run --allow-dirty",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "generate": "node scripts/generate-frozen.mjs"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.2.0"
  },
  "devDependencies": {
    "@dusk/connect": "npm:@jsr/dusk__connect@^0.2.0",
    "@types/node": "^24.12.3",
    "typescript": "~6.0.2",
    "vitest": "^4.1.9"
  }
}
