{
  "name": "@duskdomains/sdk",
  "version": "0.6.0",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./writes": "./src/writes.ts",
    "./marketplace": "./src/marketplace.ts",
    "./connect-app": "./src/wallet/duskConnectApp.ts",
    "./event-catalog": "./src/indexer/events/indexerEventCatalog.ts",
    "./projection": "./src/projection.ts",
    "./chain-addresses": "./src/chain-addresses.ts",
    "./indexer": "./src/indexer.ts",
    "./lens-reader": "./src/lens-reader.ts",
    "./names": "./src/names.ts",
    "./call-facts": "./src/call-facts.ts",
    "./releases": "./src/releases.ts",
    "./accounts": "./src/accounts.ts"
  },
  "publish": {
    "include": [
      "LICENSE",
      "README.md",
      "CHANGELOG.md",
